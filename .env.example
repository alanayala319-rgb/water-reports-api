# App
PORT=3000

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=water_reports_db

# Mail (nodemailer / SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=municipio.notificaciones@example.com
MAIL_PASSWORD=change-me
MAIL_FROM="Municipio - Reportes de Agua <municipio.notificaciones@example.com>"

# Cuadrilla de mantenimiento (destinatario de los avisos de fuga)
MAINTENANCE_CREW_EMAIL=cuadrilla.mantenimiento@example.com

# Bcrypt
BCRYPT_SALT_ROUNDS=10
