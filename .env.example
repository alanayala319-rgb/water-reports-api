# App
PORT=3000

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=CAMBIA_ESTA_PASSWORD
DB_NAME=water_reports_db

# Mail (nodemailer / SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=tu-correo@example.com
MAIL_PASSWORD=TU_PASSWORD_DE_APLICACION
MAIL_FROM="AguaFix <tu-correo@example.com>"

# Cuadrilla de mantenimiento (destinatario de los avisos de fuga)
MAINTENANCE_CREW_EMAIL=cuadrilla@example.com

# Bcrypt
BCRYPT_SALT_ROUNDS=10

# AWS: usar AWS_ACCESS_KEY_ID y AWS_SECRET_ACCESS_KEY solo en .env local, nunca en Git
AWS_REGION=us-east-1
AWS_S3_BUCKET=tu-bucket
AWS_PUBLIC_BASE_URL=
DOCKER_IMAGE=tu-usuario/water-reports-api:latest
